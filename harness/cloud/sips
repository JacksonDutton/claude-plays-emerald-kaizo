#!/usr/bin/env python3
# Linux stand-in for macOS `sips -z H W file` (the only form `g shot` uses), so cloud
# screenshots are 480x320 like the Mac's. Nearest-neighbour 2x keeps pixels crisp.
import sys
from PIL import Image
a = sys.argv[1:]
if len(a) >= 4 and a[0] == "-z":
    h, w, f = int(a[1]), int(a[2]), a[3]
    Image.open(f).resize((w, h), Image.NEAREST).save(f)
