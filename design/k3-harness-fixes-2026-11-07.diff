      fi
      n=${2:-30}; for i in $(seq 1 $n); do
        r=$(q PRESS a); [[ $r == OK* ]] || { echo "$r"; break; }
-       wait_idle; s=$(q S); t=$(q T)
+       # K3 rev 2: the text buffer can update up to ~1 s after the press (intro speech, long scripts): poll briefly.
+       wait_idle; for w in 1 2 3 4 5 6 7 8; do t=$(q T); [[ "$(txt "$t")" != "$(txt "$t0")" ]] && break; sleep 0.15; done; s=$(q S)
        if [[ "$(txt "$t")" != "$(txt "$t0")" ]]; then echo "$s"; printf '%s' "$t" > /tmp/pk_lasttext; echo "$t"; break; fi
        if [[ $s == *bat:other* ]]; then sleep 0.3; s=$(q S); fi
        b=${s/bat:other/}
        if [[ $s == *bat:* ]]; then t=$(q T); echo "$s"; [[ "$(txt "$t")" != "$(txt "$t0")" ]] && { printf '%s' "$t" > /tmp/pk_lasttext; echo "$t"; }; break; fi
        if [[ $s != *lock* || $s == *yn* || $s == *menu:* || $b == *bat:* || $s == *dec:* || $s == *learn* ]]; then echo "$s (after $i)"; break; fi
+       # K3 (7 Nov 2026, rev 2): keep pressing through further pages of the same message only while a plain
+       # overworld message box is up (g t already shows the whole message). Anywhere else (the starter choice,
+       # intro and clock screens, menus) stop after the press: those prompts raise no flag and keep T unchanged.
+       gm=$(q DIAG); mb=$(q R8 0x020375bc)
+       if [[ $gm != *'"game_mode":"overworld"'* || -z $mb || $mb == 0 ]]; then echo "$s (pressed a $i time(s), no new text; not in a plain message box now, so adv stopped. Some prompts raise no flag: take g shot before pressing again)"; break; fi
        [[ $i == $n ]] && echo "$s (max $n presses, still in same message)"
      done ;;
   name) shift   # v2: type a whole name on the naming screen, then stop (never confirms)
